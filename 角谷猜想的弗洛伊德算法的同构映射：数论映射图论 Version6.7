def collatz_path(n):
    path = []
    while n != 1:
        path.append(n)
        if n % 2 == 1:
            n = 3*n + 1
            # 除以 2 的最大幂
            i = 0
            while n % 2 == 0:
                n //= 2
                i += 1
            # 记录步骤：奇数 -> 新奇数，步数为 i
            print(f"{path[-1]} → {n} (i={i})")
        else:
            n //= 2
    path.append(1)
    return path

