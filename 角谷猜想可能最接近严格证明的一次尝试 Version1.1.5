# -*- coding: utf-8 -*-
# 角谷猜想（冰雹猜想/3n+1问题）：逆向二叉树方法的归纳证明思路分析、严格性评估与覆盖率计算
from pyecharts.charts import Line
from pyecharts import options as opts


# ---------- 1. 逆向二叉树构建（BFS，记录每个数首次被覆盖的深度） ----------
def build_reverse_tree(N_max, depth_limit=400):
    """
    逆向规则（与正向“偶数除以2、奇数乘3加1”互逆）：
      1) 任意节点 m 的子节点含 2m；
      2) 当 m ≡ 4 (mod 6) 时，子节点还含 (m-1)/3（此时 (m-1)/3 为大于1的奇数）。
    仅保留值 ≤ 3*N_max+1 的节点：更大节点 m 的逆向子节点 (m-1)/3 仍可能落回
    [2, N_max]，该上界可确保对 [2, N_max] 的覆盖不遗漏。
    返回 first_depth：n -> 首次被逆向树覆盖的深度（恰等于其正向雹程）。
    """
    value_limit = 3 * N_max + 1
    first_depth = {1: 0}
    queue = [1]
    head = 0
    while head < len(queue):
        m = queue[head]
        head += 1
        d = first_depth[m]
        if d >= depth_limit:
            continue
        children = [2 * m]
        if m % 6 == 4:
            children.append((m - 1) // 3)
        for c in children:
            if c <= value_limit and c not in first_depth:
                first_depth[c] = d + 1
                queue.append(c)
    return first_depth


# ---------- 2. 正向角谷运算（用于构造严格性的抽样回归检验） ----------
def collatz_steps(n, cap=100000):
    steps = 0
    while n != 1 and steps < cap:
        n = n // 2 if n % 2 == 0 else 3 * n + 1
        steps += 1
    return steps if n == 1 else -1


# ---------- 3. 主分析 ----------
N_list = [1000, 10000, 100000]
N_big = max(N_list)
first_depth = build_reverse_tree(N_big)

# 3.1 严格性抽样检验：逆向覆盖深度应等于正向雹程
sample = [n for n in sorted(first_depth) if 2 <= n <= N_big][::7000][:15]
ok = sum(1 for n in sample if collatz_steps(n) == first_depth[n])
print("=" * 70)
print("【严格性检验】抽样 {} 个树内节点，正向雹程与逆向深度一致：{}/{} 通过".format(
    len(sample), ok, len(sample)))
print("说明：逆向树每条边均与正向运算互逆，树内节点经正向角谷运算必回到1，")
print("      故“逆向树构造”本身是严格的；问题出在归纳步骤无法闭合（见下）。")
print("=" * 70)

# 3.2 不同深度下的覆盖率（对多个 N 对比）
depths = list(range(10, 121, 10))
results = {}
for N in N_list:
    dc = {}
    for n, d in first_depth.items():
        if 2 <= n <= N:
            dc[d] = dc.get(d, 0) + 1
    total = N - 1
    uncovered = total - sum(dc.values())
    sorted_ds = sorted(dc)
    rates = []
    cum, di = 0, 0
    for d in depths:
        while di < len(sorted_ds) and sorted_ds[di] <= d:
            cum += dc[sorted_ds[di]]
            di += 1
        rates.append(round(cum / total * 100, 2))
    results[N] = rates
    print("【覆盖率表】范围 [2, {}]（深度上限内未覆盖：{} 个）".format(N, uncovered))
    print("{:>8} {:>12}".format("深度d", "覆盖率(%)"))
    for d, r in zip(depths, rates):
        print("{:>8} {:>12}".format(d, r))
    print("-" * 70)

# 3.3 归纳法证明思路与严格性评估结论
print("【逆向二叉树方法的数学归纳法证明思路】")
print("1) 目标命题：一切正整数都在以 1 为根的逆向树中（等价于角谷猜想）。")
print("2) 归纳基础：1 在树中（1→2→4 构成循环，作为树根处理）。")
print("3) 归纳步骤：设 2..n 均在树中，考察 n+1 的逆向父节点：")
print("   · n+1 ≡ 4 (mod 6)：父节点 (n+1-1)/3 < n+1，由归纳假设在树中，归纳成功；")
print("   · n+1 为偶数：唯一逆向父节点是 2(n+1) > n+1，比归纳对象更大，强归纳失效；")
print("   · n+1 ≡ 1,3 (mod 6)：(n+1-1)/3 非奇数，无合法更小父节点，归纳失效。")
print("4) 结论：归纳步骤仅在部分剩余类上闭合，证明不严格。")
print("【严格性评估】")
print("· 逆向树构造：严格（每条逆向边可逆，已程序抽样验证）；")
print("· 有限深度验证：严格但仅为数值证据，覆盖率<100%且随 N 增大而下降；")
print("· 覆盖率趋势：随深度 d 增大呈上升趋势，但“极限为100%”恰与角谷猜想等价，")
print("  故该方法只能提供启发式支持，无法独立完成严格证明。")
print("=" * 70)

# ---------- 4. 绘制覆盖率随深度变化趋势折线图 ----------
line = Line(init_opts=opts.InitOpts(width="920px", height="520px"))
line.add_xaxis([str(d) for d in depths])
for N in N_list:
    line.add_yaxis(
        "范围[2,{}]".format(N),
        results[N],
        is_smooth=True,
        label_opts=opts.LabelOpts(is_show=(N == 1000), formatter="{c}%"),
    )
line.set_global_opts(
    title_opts=opts.TitleOpts(
        title="角谷逆向二叉树覆盖率随深度变化趋势",
        subtitle="覆盖率 = [2,N] 中雹程≤d 的数字占比",
    ),
    xaxis_opts=opts.AxisOpts(type_="category", name="逆向树深度 d"),
    yaxis_opts=opts.AxisOpts(type_="value", name="覆盖率(%)", min_=0, max_=100),
    tooltip_opts=opts.TooltipOpts(trigger="axis"),
