program CollatzDensity;
{$mode objfpc}
uses Math, SysUtils;

var
  limit: Int64;
  count: Int64;
  n: Int64;
  x: Int64;
  steps: Integer;

function CollatzIterations(num: Int64): Integer;
begin
  Result := 0;
  while num > 1 do
  begin
    if (num mod 2) = 0 then
      num := num div 2
    else
      num := 3 * num + 1;
    Inc(Result);
    if Result > 1000000 then // 防止死循环
    begin
      Result := -1;
      Exit;
    end;
  end;
end;

begin
  Write('请输入n的上限: ');
  ReadLn(limit);
  count := 0;
  for n := 1 to limit do
  begin
    x := CollatzIterations(n);
    if x >= 0 then Inc(count);
  end;
  WriteLn('在1到', limit, '中，收敛到1的数字个数: ', count);
  WriteLn('比例: ', count / limit:0:4);
end.

